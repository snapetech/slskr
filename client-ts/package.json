{
  "name": "@slskr/api-client",
  "version": "1.0.0",
  "description": "TypeScript/JavaScript client library for the slskr HTTP API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
