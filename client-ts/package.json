  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0"
  },
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "overrides": {
