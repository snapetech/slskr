  "private": true,
  "scripts": {
    "build": "vite build",
    "check:remediation": "bash ../scripts/check-remediation-baseline.sh",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "pretest:e2e": "npm run build",
    "pretest:e2e:ci": "npm run build",
    "start": "vite",
    "test": "vitest run --maxWorkers=1",
    "test:api-lifecycle-coverage": "vitest run --maxWorkers=1 --coverage src/lib/api.test.js src/lib/http.test.js src/lib/session.test.js src/lib/events.test.js src/lib/hubFactory.test.js src/lib/streaming.test.js",
    "test:bundle-budget": "python3 ../scripts/check-web-bundle-budget.py --build-dir build --initial-js-max-kib 1150 --gzip-max-kib 600",
    "test:build-output": "node ./scripts/verify-build-output.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=line",
    "test:rustymilk-compatibility": "node ./scripts/report-rustymilk-compatibility.mjs",
    "test:rustymilk-performance": "node ./scripts/measure-rustymilk-performance.mjs",
    "test:rustymilk-smoke": "node ./scripts/smoke-rustymilk.mjs",
    "test-unattended": "vitest run --maxWorkers=1"
  },
  "version": "0.1.0"
}
