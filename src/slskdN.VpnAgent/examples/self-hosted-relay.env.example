SLSKR_RELAY_TUNNEL_TYPE=wireguard
SLSKR_RELAY_IFACE=slskr-relay
SLSKR_RELAY_PUBLIC_IFACE=eth0
SLSKR_RELAY_TUNNEL_CIDR=10.77.0.0/30
SLSKR_RELAY_HOME_IP=10.77.0.2
SLSKR_RELAY_PUBLIC_PORT=50300
SLSKR_RELAY_TARGET_PORT=50300
SLSKR_RELAY_API_HOST=10.77.0.1
SLSKR_RELAY_API_PORT=8010
SLSKR_RELAY_API_KEY_FILE=/etc/slskr-relay/api-keys
SLSKR_RELAY_CONNECTION_LIMIT=128
SLSKR_RELAY_BANDWIDTH_MBIT=100
SLSKR_RELAY_HANDSHAKE_MAX_AGE=180
# Set this when outbound HTTP discovery is unavailable:
# SLSKR_RELAY_PUBLIC_IP=203.0.113.10
