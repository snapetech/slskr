{
  "name": "slskr-admin-dashboard",
  "version": "1.0.0",
  "description": "Web-based admin dashboard for slskr HTTP API",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:bundle-budget": "python3 ../scripts/check-web-bundle-budget.py --build-dir dist --initial-js-max-kib 260 --gzip-max-kib 100"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.48.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  }
}
