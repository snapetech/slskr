#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:

override_dh_auto_install:
	set -eu; \
	case "$(DEB_HOST_ARCH)" in \
		amd64) target=x86_64 ;; \
		arm64) target=aarch64 ;; \
		*) echo "unsupported Debian architecture: $(DEB_HOST_ARCH)" >&2; exit 1 ;; \
	esac; \
	archive="$$(find vendor -maxdepth 1 -type f -name "*-$$target-unknown-linux-gnu.tar.gz" -print -quit)"; \
	test -n "$$archive" || { echo "missing release archive for $$target" >&2; exit 1; }; \
	mkdir -p debian/slskr/usr/lib/slskr debian/slskr/usr/bin; \
	tar -xzf "$$archive" -C debian/slskr/usr/lib/slskr --strip-components=1; \
	ln -s ../lib/slskr/slskr debian/slskr/usr/bin/slskr
	mkdir -p debian/slskr/lib/systemd/system debian/slskr/etc/slskr debian/slskr/usr/lib/sysusers.d debian/slskr/usr/lib/tmpfiles.d
	cp lib/systemd/system/slskr.service debian/slskr/lib/systemd/system/slskr.service
	cp debian/slskr/usr/lib/slskr/docs/slskr.config.example.toml debian/slskr/etc/slskr/config.toml
	cp usr/lib/sysusers.d/slskr.conf debian/slskr/usr/lib/sysusers.d/slskr.conf
	cp usr/lib/tmpfiles.d/slskr.conf debian/slskr/usr/lib/tmpfiles.d/slskr.conf
