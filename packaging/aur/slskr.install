post_install() {
  systemd-sysusers slskr.conf
  systemd-tmpfiles --create slskr.conf
  echo "Edit /etc/slskr/config.toml, then enable with: systemctl enable --now slskr.service"
}

post_upgrade() {
  systemd-sysusers slskr.conf
  systemd-tmpfiles --create slskr.conf
}

post_remove() {
  systemctl daemon-reload >/dev/null 2>&1 || true
}
